##
## informed by 20250129 ish: here missing cast in else fails g++, not culam.
## ref type of ?: based on referenceAble of its nodes. default ref type. (see also t41069, t41662, t41706)
##
#>Tu.ulam
  ulam 3;
element Tu : Qbar{
  Bool b = true;
  Int me = 1;
  Int test(){
    System s;
    Qbar q1;
    mq = 1;

    //truetype ref, uses falsetype (non-ref), should be ref type.
    Qbar & qref = b ? (Qbar&) self : q1; //cast quark to ref; cast element decendent
    s.print(qref.mq);
    s.assert(qref.mq == 1);

    //both refs
    Tbar t1;
    t1.mq = -1;
    Qbar & qtref = (t1 is Qbar) ? (Qbar&) t1 : qref; //cast transient decendent; cast ref to ref
    s.print(qtref.mq);
    s.assert(qtref.mq == -1);

    //neither refs. but cast to refs needed; cast to same type?
    // since cast is explicit and non-ref, no longer referenceable.
    Qbar q2;
    q2.mq = 3;
    //    Qbar & qref2 = b ? (Qbar) q2 : q1; (see error/t41706)
    Qbar & qref2 = b ? q2 : q1;
    s.print(qref2.mq);
    s.assert(qref2.mq == 3);


    Int(3) mqans5 = getMQ(b ? getQBARRef(qref2) : getQBARRef(q1)); //ok w ?:
    s.print(mqans5);
    s.assert(mqans5 == 3);


    return 0;
  }

  Int(3) getMQ(Qbar& qrefarg)
  {
    Int(3) mymq = qrefarg.mq;
    return mymq;
  }

  Qbar& getQBARRef(Qbar& qrefarg)
  {
    return qrefarg;
  }

}

#:Qbar.ulam
  ulam 1;
quark Qbar {
  Int(3) mq = 2;
}

#:Tbar.ulam
  ulam 2;
transient Tbar : Qbar {
  Int mt = -1;
}


