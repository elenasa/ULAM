##
## informed by t41706: here data member array items, maintain their arrayitem-ness.
## (see also t41708,9)
##
#>Tu.ulam
  ulam 3;
element Tu {
  Bool b = true;
  Qbar m_qbarr[] = { {.mq = 1}, {.mq = 2}, {.mq = 3 } };

  Int test(){
    System s;

    //truetype ref, uses falsetype (non-ref), should be ref type.
    Qbar & qref = b ? (Qbar&) m_qbarr[0] : m_qbarr[1]; //cast quark to ref; cast element decendent
    s.print(qref.mq);
    s.assert(qref.mq == 1);

    //both refs
    Tbar t1;
    t1.mq = -1;
    Qbar & qtref = (t1 is Qbar) ? (Qbar&) t1 : qref; //cast transient decendent; cast ref to ref
    s.print(qtref.mq);
    s.assert(qtref.mq == -1);

    //neither refs. but cast to refs needed; cast to same type?
    // since cast is explicit and non-ref, no longer referenceable.
    Qbar & qref2 = b ? m_qbarr[2] : m_qbarr[1];
    s.print(qref2.mq);
    s.assert(qref2.mq == 3);

    b = false;

    Int(3) mqans5 = getMQ(b ? getQBARRef(m_qbarr[2]) : getQBARRef(m_qbarr[0])); //ok w ?:
    s.print(mqans5);
    s.assert(mqans5 == 1);


    return 0;
  }

  Int(3) getMQ(Qbar& qrefarg)
  {
    Int(3) mymq = qrefarg.mq;
    return mymq;
  }

  Qbar& getQBARRef(Qbar& qrefarg)
  {
    return qrefarg;
  }

}

#:Qbar.ulam
  ulam 1;
quark Qbar {
  Int(3) mq = 2;
}

#:Tbar.ulam
  ulam 2;
transient Tbar : Qbar {
  Int mt = -1;
}


