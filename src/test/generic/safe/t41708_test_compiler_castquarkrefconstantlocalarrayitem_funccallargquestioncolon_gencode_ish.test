##
## informed by t41707: here local constant array, cannot be referenced.
## ref type of ?: based on referenceAble of its nodes. default ref type. (see also t41069, t41662, t41705,6,7)
##
#>Tu.ulam
  ulam 3;

  //note: can't be used as a reference parameter
  local constant Qbar c_qbarr[] = { {.mq = 1}, {.mq = 2}, {.mq = 3 } };

element Tu {
  Bool b = true;

  Int test(){
    System s;

    //truetype ref, uses falsetype (non-ref), should be ref type.
    Qbar qbar = b ? c_qbarr[0] : c_qbarr[1]; //cast quark to ref; cast element decendent
    s.print(qbar.mq);
    s.assert(qbar.mq == 1);

    //both refs
    Tbar t1;
    t1.mq = -1;
    Qbar & qtref = (t1 is Qbar) ? (Qbar&) t1 : qbar; //cast transient decendent; cast ref to ref
    s.print(qtref.mq); //==7
    s.assert(qtref.mq == -1);

    //neither refs. but cast to refs needed; cast to same type?
    // since cast is explicit and non-ref, no longer referenceable.
    Qbar qbar2 = b ? c_qbarr[2] : c_qbarr[1];
    s.print(qbar2.mq);
    s.assert(qbar2.mq == 3);

    b = false;
    Int(3) mqans5 = getMQ(b ? getQBARCopy(c_qbarr[2]) : getQBARCopy(c_qbarr[0])); //ok w ?:
    s.print(mqans5);
    s.assert(mqans5 == 1);

    return 0;
  }

  Int(3) getMQ(Qbar qrefarg)
  {
    Int(3) mymq = qrefarg.mq;
    return mymq;
  }

  Qbar getQBARCopy(Qbar qrefarg)
  {
    return qrefarg;
  }

}

#:Qbar.ulam
  ulam 1;
quark Qbar {
  Int(3) mq = 2;
}

#:Tbar.ulam
  ulam 2;
transient Tbar : Qbar {
  Int mt = -1;
}


