Exit status: 0
Ue_A { Unsigned m_minof(0u);  Unsigned m_classidof(1u);  Int test() {  MyElement e;  self m_minof . e ( )func . = self m_classidof . e ( )func2 . = 0 cast return } }
Ue_MyElement : TBase(3) { typedef SomeTypeClass CopyOfBaseClassSomeType;  typedef Unsigned(4) SomeType;  :TBase(3)< typedef SomeTypeClass SomeType; > <NOMAIN> }
Uq_SomeTypeClass { /* empty class block */ }
