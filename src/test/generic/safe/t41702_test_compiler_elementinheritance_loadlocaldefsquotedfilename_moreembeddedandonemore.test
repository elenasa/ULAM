#>Foo.ulam
  ulam 3;
load "Constants.txt";

element Foo : Soo3 {
  Bool(7) sp;
  Unsigned a = 73;
  Int test() {
    System s;
    Foo f;
    a = f.us;
    s.print(a);
    s.assert(a == 4u);
    a = Soo3.sizeof;
    s.print(a);
    s.assert(a == 3u);

    sp = func();
    s.assert(sp);
    return (Int) a; //=3
  }
}

#:Soo.ulam
  ulam 2;
load "Constants.txt";
local constant Int onemore = 1;

quark Soo(Unsigned(3) v) {
  Unsigned(v) us = 3u + onemore;
  Bool check()
  {
    return us.sizeof == soosize; //uses its local constant
  }
  Bool func()
  {
    if(self is Soo3) //uses its local typedef
      return check();
    return nomore;
  }
}

#:Constants.txt
local constant Unsigned(3) soosize = 3u;
local typedef Soo(soosize) Soo3;
load "More.txt";


#:More.txt
  local constant Bool nomore = false;


#:System.ulam
ulam 1;
quark System {
Void print(Unsigned arg) native;
Void print(Int arg) native;
Void print(Int(4) arg) native;
Void print(Int(3) arg) native;
Void print(Unary(3) arg) native;
Void print(Bool(3) arg) native;
Void assert(Bool b) native;
}
