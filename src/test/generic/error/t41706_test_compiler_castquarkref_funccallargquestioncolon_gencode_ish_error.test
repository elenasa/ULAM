#>Tu.ulam
  ulam 3;
element Tu : Qbar{
  Bool b = true;
  Int me = 1;
  Int test(){
    System s;
    Qbar q1;
    mq = 1;

    //neither refs. but cast to refs needed; cast to same type?
    // since cast is explicit and non-ref, no longer referenceable.
    Qbar q2;
    q2.mq = 3;
    Int(3) mqans3 = getMQ(b ? (Qbar) q2 : q1);
    s.print(mqans3);
    s.assert(mqans3 == 3);

    //pure virtual method called terminate called without an active exception
    Qbar & q2ref = q2;
    Int(3) mqans4 = getMQ(b ? getQBARCopy(q2ref) : getQBARCopy(q1));
    s.print(mqans4);
    s.assert(mqans4 == 3);

    //instanceof is Not referenceAble
    Int(3) mqans5 = getMQ(b ? Qbar.instanceof : q1);
    s.print(mqans5);
    s.assert(mqans5 == 2);

    return 0;
  }

  Int(3) getMQ(Qbar& qrefarg)
  {
    Int(3) mymq = qrefarg.mq;
    return mymq;
  }

  Qbar getQBARCopy(Qbar& qrefarg)
  {
    Qbar b;
    b.mq = qrefarg.mq;
    return b;
  }

  Qbar& getQBARRef(Qbar& qrefarg)
  {
    return qrefarg;
  }
}

