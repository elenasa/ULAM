## -*- mode:ulam -*-
#=t41714_test_compiler_constantclassarrayoftransientstoobig_error
#!
./R.ulam:1:3: ERROR: Trying to exceed allotted bit size (8192) for array KeyExprNode with 9600 bits.
./R.ulam:11:9: ERROR: Trying to exceed allotted bit size (8192) for array KeyExprNode with 9600 bits.
Unrecoverable Program Type Label FAILURE.
##
## see error t41633, constant array of transient items 8k-bits total are okay.
## (see also safe/t41715)
##
#>R.ulam
  ulam 5;
use KeyExprNode;
local constant KeyExprNode k00 = { .m_leftIndex = 1, .m_rightIndex = 2, .m_keyCode = 0, .m_op = '|' }; // [0]
local constant KeyExprNode k01 = { .m_leftIndex = 3, .m_rightIndex = 4, .m_keyCode = 0, .m_op = '&' }; // [1]
local constant KeyExprNode k02 = { .m_leftIndex = 0, .m_rightIndex = 0, .m_keyCode = 'c', .m_op = 0 }; // [2]
local constant KeyExprNode k03 = { .m_leftIndex = 0, .m_rightIndex = 0, .m_keyCode = 'a', .m_op = 0 }; // [3]
local constant KeyExprNode k04 = { .m_leftIndex = 0, .m_rightIndex = 0, .m_keyCode = 'b', .m_op = 0 }; // [4]

local constant KeyExprNode keyexpr_x13[120] = {  k00, k01, k02, k03, k04 };

element R {
  Int test() {
    System s;
    KeyExprRep kr;
    kr.m_key = keyexpr_x13[0]; //displayed in eval output
    s.assert(kr.m_key.m_rightIndex==2u);

    s.assert(keyexpr_x13[1].m_rightIndex==4u); //reads constant class array item

    //read entire constant class array
    KeyExprNode mykeyexpr_x13[120] = local.keyexpr_x13; // see t41552 for error without dot
    s.print(mykeyexpr_x13[2].m_keyCode);
    s.assert(mykeyexpr_x13[2].m_keyCode==keyexpr_x13[2].m_keyCode); //reads constant class array item
    return 0;
  }


}

#:KeyExprRep.ulam
  ulam 3;
transient KeyExprRep {
  KeyExprNode m_key;
}

#:KeyExprNode.ulam
  ulam 3;
transient KeyExprNode {
  typedef Unsigned(20) Byte; // TOO BIG!!

  Byte m_leftIndex;  // for [,|&~]
  Byte m_rightIndex; // for [,|&]
  Byte m_keyCode;    // [a-zA-Z.@_?] or 0
  Byte m_op;         // [,|&~] or 0
}

#:System.ulam
  ulam 1;
quark System {
  Void print(Unsigned arg) native;
  Void print(Int arg) native;
  Void print(Int(4) arg) native;
  Void print(Int(3) arg) native;
  Void print(Unary(3) arg) native;
  Void print(Bool(3) arg) native;
  Void assert(Bool b) native;
}
#.
