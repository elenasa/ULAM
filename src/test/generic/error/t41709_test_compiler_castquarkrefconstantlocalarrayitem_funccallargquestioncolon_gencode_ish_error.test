##
## informed by t41707: here local constant array items, cannot be referenced or used as ref args.
## (see also t41708)
##
#>Tu.ulam
  ulam 3;
local constant Qbar c_qbarr[] = { {.mq = 1}, {.mq = 2}, {.mq = 3 } };

element Tu {
  Bool b = true;

  Int test(){
    System s;

    //truetype ref of constant error
    Qbar & qref = b ? (Qbar&) c_qbarr[0] : c_qbarr[1];
    s.print(qref.mq);
    s.assert(qref.mq == 1);

    //both refs, but qref failed initialization.
    Tbar t1;
    t1.mq = -1;
    Qbar & qtref = (t1 is Qbar) ? (Qbar&) t1 : qref; //cast transient decendent; cast ref to ref
    s.print(qtref.mq);
    s.assert(qtref.mq == -1);

    //neither refs. but cast to refs needed; cast to same type?
    // since cast is explicit and non-ref, no longer referenceable.
    Qbar & qref2 = b ? c_qbarr[2] : c_qbarr[1];
    s.print(qref2.mq);
    s.assert(qref2.mq == 3);

    b = false;

    Int(3) mqans5 = getMQ(b ? getQBARRef(c_qbarr[2]) : getQBARRef(c_qbarr[0])); //ok w ?:
    s.print(mqans5);
    s.assert(mqans5 == 1);


    return 0;
  }

  Int(3) getMQ(Qbar& qrefarg)
  {
    Int(3) mymq = qrefarg.mq;
    return mymq;
  }

  Qbar& getQBARRef(Qbar& qrefarg)
  {
    return qrefarg;
  }

}

#:Qbar.ulam
  ulam 1;
quark Qbar {
  Int(3) mq = 2;
}

#:Tbar.ulam
  ulam 2;
transient Tbar : Qbar {
  Int mt = -1;
}


